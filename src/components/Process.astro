---
const steps = [
  { n: 1, name: 'Discovery', body: 'We learn about your business, goals, and target audience.', icon: 'search' },
  { n: 2, name: 'Design', body: 'We create a strategy and design that converts.', icon: 'pen' },
  { n: 3, name: 'Development', body: 'Clean, efficient code built for speed and scalability.', icon: 'code' },
  { n: 4, name: 'Launch', body: 'Rigorous testing and a smooth launch.', icon: 'rocket' },
  { n: 5, name: 'Growth', body: 'Ongoing optimization, SEO, and support.', icon: 'chart' }
];

const icons: Record<string, string> = {
  search: '<circle cx="11" cy="11" r="6"/><path d="M20 20l-4.35-4.35"/>',
  pen: '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/>',
  code: '<path d="M8 6l-5 6 5 6M16 6l5 6-5 6"/>',
  rocket: '<path d="M12 2c2.5 2 4 5 4 9 0 2-1 4-2 5l-2 2-2-2c-1-1-2-3-2-5 0-4 1.5-7 4-9z"/><path d="M9 15l-3 3M15 15l3 3"/>',
  chart: '<path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-6"/>'
};
---

<section id="process" class="process">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">My Process</span>
      <h2>A clear process, proven results.</h2>
    </div>

    <div class="steps">
      {steps.map((s) => (
        <div class="step">
          <div class="step-circle">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={icons[s.icon]} />
            <span class="step-n">{s.n}</span>
          </div>
          <h3>{s.name}</h3>
          <p>{s.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .process {
    background: var(--bg);
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
  }

  .steps::before {
    content: '';
    position: absolute;
    top: 30px;
    left: 10%;
    right: 10%;
    height: 1px;
    background-image: linear-gradient(90deg, var(--border-light) 40%, transparent 40%);
    background-size: 10px 1px;
    z-index: 0;
  }

  .step {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .step-circle {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 62px;
    height: 62px;
    border-radius: 50%;
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    color: var(--blue-light);
    margin-bottom: 1.1rem;
  }

  .step-circle svg {
    width: 24px;
    height: 24px;
  }

  .step-n {
    position: absolute;
    top: -4px;
    right: -4px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--gradient);
    color: #fff;
    font-size: 0.62rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .step h3 {
    font-size: 1.02rem;
  }

  .step p {
    margin: 0.5rem auto 0;
    font-size: 0.85rem;
    max-width: 20ch;
  }

  @media (max-width: 800px) {
    .steps {
      grid-template-columns: 1fr 1fr;
    }
    .steps::before {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
