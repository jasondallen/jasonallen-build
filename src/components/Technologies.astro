---
const stack = [
  { name: 'HTML5', slug: 'html5', color: 'E34F26' },
  { name: 'CSS3', slug: 'css3', color: '1572B6' },
  { name: 'JavaScript', slug: 'javascript', color: 'F7DF1E' },
  { name: 'TypeScript', slug: 'typescript', color: '3178C6' },
  { name: 'PHP', slug: 'php', color: '787CB5' },
  { name: 'Laravel', slug: 'laravel', color: 'FF2D20' },
  { name: 'WordPress', slug: 'wordpress', color: '8FB2C9' },
  { name: 'React', slug: 'react', color: '61DAFB' },
  { name: 'Next.js', slug: 'nextdotjs', color: 'FFFFFF' },
  { name: 'Tailwind CSS', slug: 'tailwindcss', color: '38BDF8' },
  { name: 'MySQL', slug: 'mysql', color: '4479A1' },
  { name: 'Docker', slug: 'docker', color: '2496ED' },
  { name: 'Cloudflare', slug: 'cloudflare', color: 'F38020' },
  { name: 'GitHub', slug: 'github', color: 'FFFFFF' },
  { name: 'OpenAI', slug: 'openai', color: 'FFFFFF' }
];
---

<section class="tech">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Technologies I Work With</span>
    </div>

    <ul class="tech-grid">
      {stack.map((t) => (
        <li>
          <span class="tech-icon">
            <img src={`https://cdn.simpleicons.org/${t.slug}/${t.color}`} alt={t.name} loading="lazy" />
          </span>
          <span class="tech-name">{t.name}</span>
        </li>
      ))}
      <li>
        <span class="tech-icon">
          <svg viewBox="0 0 24 24" fill="#d97757">
            <path d="M12 2l1.4 6.6L20 10l-6.6 1.4L12 18l-1.4-6.6L4 10l6.6-1.4L12 2z" />
          </svg>
        </span>
        <span class="tech-name">Claude</span>
      </li>
    </ul>
  </div>
</section>

<style>
  .tech {
    background: var(--bg-elevated);
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-block: 1px solid var(--border);
  }

  .tech .section-head {
    margin-bottom: 2rem;
  }

  .tech-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(16, 1fr);
    gap: 0.6rem;
  }

  .tech-grid li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .tech-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 9px;
    background: var(--bg-card);
    border: 1px solid var(--border-light);
  }

  .tech-icon img,
  .tech-icon svg {
    width: 19px;
    height: 19px;
  }

  .tech-name {
    font-size: 0.6rem;
    color: var(--text-dim);
    text-align: center;
    line-height: 1.2;
  }

  @media (max-width: 900px) {
    .tech-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 480px) {
    .tech-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>