---
---

<section class="cta-banner">
  <div class="wrap cta-inner">
    <div class="cta-left">
      <span class="cta-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 6l-5 6 5 6M16 6l5 6-5 6" />
        </svg>
      </span>
      <div>
        <h2>Ready to build something amazing?</h2>
        <p>Let&rsquo;s create a website that works as hard as you do.</p>
      </div>
    </div>
    <a href="#contact" class="btn btn-light">Schedule a Call &rarr;</a>
  </div>
</section>

<style>
  .cta-banner {
    background: var(--gradient);
    padding-block: clamp(2.25rem, 5vw, 3.25rem);
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .cta-left {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .cta-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.5);
    color: #fff;
    flex-shrink: 0;
  }

  .cta-icon svg {
    width: 24px;
    height: 24px;
  }

  .cta-banner h2 {
    color: #fff;
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
  }

  .cta-banner p {
    margin-top: 0.35rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .btn-light {
    background: #0a0e1a;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    white-space: nowrap;
  }

  .btn-light:hover {
    background: #10182b;
  }
</style>
