---
const projects = [
  {
    name: 'CAM Construction Group',
    tag: 'Commercial Construction',
    body: 'Custom WordPress website with advanced SEO, project galleries, and a lead generation system.',
    accent: '#3b82f6'
  },
  {
    name: 'Power Core Peptides',
    tag: 'Ecommerce',
    body: 'WooCommerce store with memberships, subscriptions, and secure payment processing.',
    accent: '#8b5cf6'
  }
];
---

<section id="portfolio" class="projects">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Featured Projects</span>
      <h2>Recent work that makes an impact</h2>
    </div>

    <div class="projects-grid">
      {projects.map((p) => (
        <div class="project-card">
          <div class="device-mock" aria-hidden="true" style={`--accent:${p.accent}`}>
            <div class="laptop">
              <div class="laptop-bar">
                <span></span><span></span><span></span>
              </div>
              <div class="laptop-screen">
                <div class="mock-line w60"></div>
                <div class="mock-line w40"></div>
                <div class="mock-block"></div>
              </div>
            </div>
            <div class="phone">
              <div class="phone-screen">
                <div class="mock-line w80"></div>
                <div class="mock-block small"></div>
              </div>
            </div>
          </div>

          <div class="project-info">
            <h3>{p.name}</h3>
            <span class="project-tag">{p.tag}</span>
            <p>{p.body}</p>
            <a href="#contact" class="learn-more">View Case Study &rarr;</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .projects {
    background: var(--bg-elevated);
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .project-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.75rem;
  }

  .device-mock {
    position: relative;
    padding: 1.5rem 1rem 2.25rem;
    background: radial-gradient(circle at 30% 20%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 60%);
    border-radius: 12px;
    min-height: 180px;
  }

  .laptop {
    width: 78%;
    margin-inline: auto;
    background: #0d1424;
    border: 1px solid var(--border-light);
    border-radius: 8px 8px 3px 3px;
    overflow: hidden;
  }

  .laptop-bar {
    display: flex;
    gap: 4px;
    padding: 0.4rem 0.6rem;
    background: #0a0f1c;
  }

  .laptop-bar span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--border-light);
  }

  .laptop-screen {
    padding: 0.9rem;
    display: grid;
    gap: 0.5rem;
  }

  .phone {
    position: absolute;
    right: 6%;
    bottom: -8%;
    width: 62px;
    background: #0d1424;
    border: 1px solid var(--border-light);
    border-radius: 10px;
    padding: 6px;
    box-shadow: 0 12px 24px -10px rgba(0, 0, 0, 0.6);
  }

  .phone-screen {
    display: grid;
    gap: 6px;
    background: #0a0f1c;
    border-radius: 6px;
    padding: 8px 6px;
  }

  .mock-line {
    height: 6px;
    border-radius: 3px;
    background: var(--accent);
    opacity: 0.5;
  }

  .mock-block {
    height: 28px;
    border-radius: 4px;
    background: var(--accent);
    opacity: 0.25;
  }

  .mock-block.small {
    height: 18px;
  }

  .w60 { width: 60%; }
  .w40 { width: 40%; }
  .w80 { width: 80%; }

  .project-info {
    margin-top: 1.5rem;
  }

  .project-info h3 {
    font-size: 1.2rem;
  }

  .project-tag {
    display: inline-block;
    margin-top: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--blue-light);
  }

  .project-info p {
    margin-top: 0.75rem;
    font-size: 0.95rem;
  }

  .learn-more {
    display: inline-block;
    margin-top: 1.1rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--blue-light);
  }

  @media (max-width: 800px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
