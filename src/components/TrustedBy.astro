---
const clients = [
  { name: 'CAM', sub: 'Construction Group' },
  { name: 'Power Core', sub: 'Peptides' },
  { name: 'Axis', sub: 'Automation' },
  { name: 'Summit', sub: 'Property Group' },
  { name: 'Brighter Futures', sub: '' }
];
---

<section class="trusted">
  <div class="wrap trusted-bar">
    <span class="trusted-label">
      TRUSTED BY<br /><span>GREAT COMPANIES</span>
    </span>
    <ul class="trusted-list">
      {clients.map((c) => (
        <li>
          <span class="mark">{c.name.charAt(0)}</span>
          <span class="name">
            {c.name}
            {c.sub && <small>{c.sub}</small>}
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trusted {
    background: var(--bg-elevated);
    border-block: 1px solid var(--border);
    padding-block: 1.75rem;
  }

  .trusted-bar {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  .trusted-label {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-dim);
    line-height: 1.5;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .trusted-label span {
    color: var(--text-muted);
  }

  .trusted-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    margin: 0;
    padding: 0;
    flex: 1;
  }

  .trusted-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-dim);
    opacity: 0.8;
  }

  .mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border: 1px solid var(--border-light);
    border-radius: 5px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .name small {
    display: block;
    font-weight: 500;
    font-size: 0.65rem;
    letter-spacing: 0.03em;
    color: var(--text-dim);
  }
</style>
