---
const tiers = [
  {
    name: 'Starter',
    body: 'Perfect for small businesses just getting started.',
    price: '$995+',
    features: ['Up to 5 Pages', 'Mobile Responsive', 'Basic SEO Setup', 'Contact Form', '1 Round of Revisions'],
    cta: 'Get Started',
    featured: false
  },
  {
    name: 'Business',
    body: 'Everything you need to grow your business online.',
    price: '$2,500+',
    features: ['Up to 15 Pages', 'Custom Design', 'Advanced SEO', 'Speed Optimization', 'CMS Integration', '2 Rounds of Revisions'],
    cta: 'Get Started',
    featured: true
  },
  {
    name: 'Custom',
    body: 'Tailored solutions for complex projects and advanced needs.',
    price: "Let's Talk",
    features: ['Custom Features', 'Web Applications', 'AI Integrations', 'API Development', 'Ongoing Support'],
    cta: 'Contact Me',
    featured: false
  }
];
---

<section id="pricing" class="pricing">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Pricing</span>
      <h2>Simple, transparent pricing</h2>
    </div>

    <div class="pricing-grid">
      {tiers.map((t) => (
        <div class={`tier-card ${t.featured ? 'featured' : ''}`}>
          {t.featured && <span class="badge-popular">Most Popular</span>}
          <h3>{t.name}</h3>
          <p class="tier-body">{t.body}</p>
          <div class="tier-price">{t.price}</div>
          <ul class="tier-features">
            {t.features.map((f) => (
              <li><span class="check">&#10003;</span>{f}</li>
            ))}
          </ul>
          <a href="#contact" class={`btn btn-block ${t.featured ? 'btn-primary' : 'btn-outline'}`}>{t.cta}</a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .pricing {
    background: var(--bg-elevated);
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: stretch;
  }

  .tier-card {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
  }

  .tier-card.featured {
    border-color: var(--purple);
    box-shadow: 0 0 0 1px var(--purple), 0 20px 40px -20px rgba(139, 92, 246, 0.35);
  }

  .badge-popular {
    position: absolute;
    top: -13px;
    left: 1.75rem;
    background: var(--gradient);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
  }

  .tier-card h3 {
    font-size: 1.2rem;
  }

  .tier-body {
    margin-top: 0.5rem;
    font-size: 0.9rem;
  }

  .tier-price {
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.1rem;
    color: var(--text);
  }

  .tier-features {
    list-style: none;
    margin: 1.75rem 0 2rem;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    flex: 1;
  }

  .tier-features li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.92rem;
    color: var(--text-muted);
  }

  .check {
    color: #34d399;
    font-weight: 700;
  }

  .btn-block {
    justify-content: center;
    width: 100%;
  }

  @media (max-width: 900px) {
    .pricing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
